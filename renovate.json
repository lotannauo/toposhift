{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "disabled",
  "packageRules": [
    {
      "description": "Major versions of the storage engine and the embedded message bus are merged by hand.",
      "matchPackageNames": [
        "github.com/cockroachdb/pebble",
        "github.com/cockroachdb/pebble/**",
        "github.com/nats-io/nats-server",
        "github.com/nats-io/nats-server/**"
      ],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["manual-review"]
    },
    {
      "description": "The MCP SDK is taken only at a release at least 14 days old and merged by hand after govulncheck and the purego build. A security fix bypasses the age (Renovate's default for vulnerability updates).",
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/modelcontextprotocol/go-sdk",
        "github.com/modelcontextprotocol/go-sdk/**"
      ],
      "minimumReleaseAge": "14 days",
      "internalChecksFilter": "strict",
      "automerge": false,
      "labels": ["manual-review"]
    },
    {
      "description": "A new major version of the MCP SDK is a new decision: no pull request until it is approved on the dependency dashboard.",
      "matchDatasources": ["go"],
      "matchPackageNames": [
        "github.com/modelcontextprotocol/go-sdk",
        "github.com/modelcontextprotocol/go-sdk/**"
      ],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The Node noise measurement's pins are registered (gate log); never bumped.",
      "matchFileNames": ["bench/wirenoise/**"],
      "enabled": false
    },
    {
      "description": "The DuckDB baseline's pins are registered; never bumped.",
      "matchFileNames": ["bench/duckdb/**", ".github/workflows/duckdb.yml"],
      "enabled": false
    }
  ]
}
